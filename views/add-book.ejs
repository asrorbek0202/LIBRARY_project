<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yangi Kitob Qo'shish</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body class="bg-light">

  <div class="container py-5" style="max-width: 600px;">
    <h2 class="mb-4 text-center">📚 Yangi Kitob Qo'shish</h2>
    
    <div class="card shadow-sm p-4">
      <form action="/add-book" method="POST">
        
        <div class="form-group mb-3">
          <label for="title">Kitob nomi</label>
          <input type="text" id="title" name="title" class="form-control" required placeholder="Masalan: O'tkan kunlar">
        </div>

        <div class="form-group mb-3">
          <label for="author">Muallif</label>
          <input type="text" id="author" name="author" class="form-control" required placeholder="Masalan: Abdulla Qodiriy">
        </div>

        <div class="form-group mb-4">
          <label for="genre">Janr</label>
          <input type="text" id="genre" name="genre" class="form-control" required placeholder="Masalan: badiiy / diniy / ilmiy / motivatsiya">
        </div>

        <div class="d-flex justify-content-between">
          <a href="/" class="btn btn-secondary">Ortga qaytish</a>
          <button type="submit" class="btn btn-success">Kitobni saqlash</button>
        </div>

      </form>
    </div>
  </div>

</body>
</html>