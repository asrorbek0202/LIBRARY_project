<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kutubxona</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="/main.css">
</head>
<body class="bg-light">

  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3">📚 Onlayn Kutubxona</h1>
      <a href="/add-book" class="btn btn-primary">+ Yangi Kitob Qo'shish</a>
    </div>

    <div class="row">
      <% if (books && books.length > 0) { %>
        <% books.forEach(function(book) { %>
          <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
              <img src="<%= book.imageUrl %>" class="card-img-top" alt="<%= book.title %>" style="height: 200px; object-fit: cover;">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= book.title %></h5>
                <p class="card-text text-muted">Muallif: <%= book.author %></p>
                <p class="card-text">Janr: <span class="badge badge-info"><%= book.genre %></span></p>
                <a href="/book/<%= book._id %>" class="btn btn-outline-primary mt-auto">Batafsil / Sharhlar</a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <p class="text-muted fs-5">Hozircha hech qanday kitob mavjud emas.</p>
        </div>
      <% } %>
    </div>
  </div>

</body>
</html>